# Copy to project root as .env (never commit .env)
# cp config/example.env .env

# OpenAI-compatible LLM (DeepSeek / OpenAI / Groq / Ollama / OpenRouter)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# CapSolver — reCaptchaV2 / V3 / Cloudflare Turnstile only (no hCaptcha)
CAPSOLVER_API_KEY=

# Job-site account defaults (used when ATS requires login/signup)
APPLY_EMAIL=
APPLY_PASSWORD=

# Gmail inbox used for OTP (same account as APPLY_EMAIL is typical)
GMAIL_ADDRESS=
GMAIL_PASSWORD=

# Durable Chrome profile — one-time Gmail login persists here (default)
CHROME_USER_DATA_DIR=data/browser_state

# LaTeX overrides only if not on PATH (generic MiKTeX pattern — expand %LOCALAPPDATA% yourself)
# XELATEX=%LOCALAPPDATA%\Programs\MiKTeX\miktex\bin\x64\xelatex.exe
# PDFLATEX=%LOCALAPPDATA%\Programs\MiKTeX\miktex\bin\x64\pdflatex.exe
